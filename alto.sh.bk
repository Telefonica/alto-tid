#!/bin/bash

# Manejar CTRL+C para detener tcpdump y salir del script
trap "echo 'Interrumpido con CTRL-C. Finalizando tcpdump y saliendo...'; kill \$TCPDUMP_PID; exit" SIGINT

# Activar el entorno virtual
source alto/bin/activate

# Generar un timestamp para el archivo de captura
TIME=$(date +"%Y%m%d_%H%M%S")
TRACE_FILE="traza_${TIME}.pcap"

# Iniciar tcpdump en segundo plano
echo "Iniciando captura de tráfico en ${TRACE_FILE}..."
tcpdump -w "${TRACE_FILE}" &  # Guarda la salida de tcpdump en el archivo
TCPDUMP_PID=$!  # Capturar el PID del proceso tcpdump

# Bucle para ejecutar alto_core.py de forma persistente
while true; do
    python3 alto_core.py
    if [ $? -ne 0 ]; then
        echo "alto_core.py falló. Reiniciando..."
        sleep 2  # Espera 2 segundos antes de reiniciar
    else
        break  # Sale del bucle si no hay errores
    fi
done

# Desactivar el entorno virtual y detener tcpdump
echo "Finalizando tcpdump..."
kill $TCPDUMP_PID
deactivate

